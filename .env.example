# Reference only: export these as environment variables; no automatic .env loading.
JARVIS_MIC_DEVICE_INDEX=default
# Leave empty to use the device native sample rate.
JARVIS_MIC_SAMPLE_RATE=
# Debug diagnostics never include transcripts or dictated email bodies.
JARVIS_DEBUG=0
JARVIS_MUSIC_DIR=C:\PATH\TO\Music
JARVIS_CODE_PATH=C:\PATH\TO\Code.exe
JARVIS_EMAIL_ADDRESS=your-address@example.com
JARVIS_EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
JARVIS_EMAIL_TO=recipient@example.com


# v0.2.1 settings (export in your shell; not automatically loaded)
JARVIS_RECOGNITION_LANGUAGE=en-in
JARVIS_LISTEN_TIMEOUT=5
JARVIS_PHRASE_TIME_LIMIT=10
JARVIS_RECOGNITION_TIMEOUT=10
JARVIS_MIC_CHUNK_SIZE=1024
JARVIS_CALIBRATION_DURATION=1
JARVIS_ENERGY_THRESHOLD=300
JARVIS_DYNAMIC_ENERGY=true
JARVIS_PAUSE_THRESHOLD=1
JARVIS_PHRASE_THRESHOLD=0.2
JARVIS_AUDIO_SETTLE_TIME=0.3
JARVIS_RETRY_DELAY=1
JARVIS_MAX_RETRY_DELAY=8
JARVIS_TTS_VOICE_INDEX=0
JARVIS_TTS_RATE=200
JARVIS_TTS_VOLUME=1


# v0.3 Phase 1.1 AI: opt-in only; export in your shell (no automatic .env loading).
# Supported providers: disabled, openai, gemini. Built-in commands take priority.
JARVIS_AI_PROVIDER=disabled
# Required when AI is enabled: OpenAI Responses model or Gemini Chat Completions model.
# Gemini example: JARVIS_AI_PROVIDER=gemini and JARVIS_AI_MODEL=gemini-3.8-flash.
# Each provider selects a fixed HTTPS endpoint; no base-URL variable is supported.
JARVIS_AI_MODEL=
# Leave blank here; provide the real credential securely in the environment.
# OpenAI only; never put a Gemini key in this variable.
OPENAI_API_KEY=
# Gemini only; no fallback to OPENAI_API_KEY. Leave blank in this tracked reference.
GEMINI_API_KEY=
JARVIS_AI_TIMEOUT=15
JARVIS_AI_HISTORY_TURNS=6
JARVIS_AI_HISTORY_CHARS=12000
JARVIS_AI_INPUT_CHARS=2000
JARVIS_AI_RESPONSE_CHARS=600
# Runtime defaults when unset: OpenAI 256, Gemini 1024.
# For Gemini, explicitly use 1024 (up to 2048) to leave room for thinking.
JARVIS_AI_MAX_OUTPUT_TOKENS=256
# History is session-only. Enabled AI sends questions/context to the provider,
# including in text dry-run mode. Responses are printed; no transcript files are saved.
